	RunService.RenderStepped:Connect(function(dt)
		if not fly.On then
			if flyTarget then detachFly() end
			return
		end

		local myChar = lp.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		if not (myHrp and myHum) then return end

		local seat = myHum.SeatPart

		if seat then
			detachFly()
			myHum.PlatformStand = false

			local root = seat.AssemblyRootPart or seat
			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero

			local cf = root.CFrame
			local yaw = 0
			if UIS:IsKeyDown(Enum.KeyCode.Q) then yaw += 1 end
			if UIS:IsKeyDown(Enum.KeyCode.E) then yaw -= 1 end
			if yaw ~= 0 then
				cf = CFrame.new(cf.Position) * CFrame.Angles(0, yaw * 2 * dt, 0) * cf.Rotation
			end

			root.CFrame = cf + dir * fly.Speed * dt
		else
			if myHrp ~= flyTarget or not bv or not bv.Parent then
				attachFly(myHrp)
			end
			myHum.PlatformStand = true
			myHum.AutoRotate = false

			local move = cam.CFrame:VectorToObjectSpace(myHum.MoveDirection)
			local dir = cam.CFrame.RightVector * move.X + cam.CFrame.LookVector * -move.Z
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
			if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

			bv.Velocity = dir * fly.Speed

			local look = cam.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude > 0.01 then
				bg.CFrame = CFrame.lookAt(myHrp.Position, myHrp.Position + flat)
			end
		end
	end)

	-- ========= ESP: ATUALIZAÇÃO LIMITADA =========
	local ESP_INTERVAL = 0.15    -- atualiza ~7x por segundo
	local VIS_INTERVAL = 0.4     -- checagem de parede por jogador
	local VIS_MAX_PER_TICK = 2   -- máximo de raycasts por atualização
	local BOX_INTERVAL = 2       -- recalcula o tamanho da caixa a cada 2 segundos
	local espClock = 0

	local function setText(label, text)
