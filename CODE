			Values = playerNames(),
			Callback = function(value)
				tp.Selected = value
			end,
		})
	end)

	tpTab:Button({
		Title = "Teleportar para o jogador escolhido",
		Desc = "Leva você até o jogador selecionado na lista (e o carro junto, se estiver sentado).",
		Callback = function()
			if not tp.Selected then
