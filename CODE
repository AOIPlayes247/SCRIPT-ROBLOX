	local fly = { On = false, Speed = 50 }
	local bv, bg, flyTarget

	local function syncFly(state)
		if flyToggle then
			syncing = true
			pcall(function() flyToggle:Set(state) end)
			syncing = false
		end
	end

	local function detachFly()
		if bv then bv:Destroy() bv = nil end
		if bg then bg:Destroy() bg = nil end
		flyTarget = nil
	end

	local function attachFly(target)
		detachFly()
		flyTarget = target

		bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.Velocity = Vector3.zero
		bv.Parent = target

		bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bg.P = 3e4
		bg.D = 1e3
		bg.CFrame = target.CFrame
		bg.Parent = target
	end

	local function stopFly()
		fly.On = false
		detachFly()
		local hum = getHum()
		if hum then
			hum.PlatformStand = false
			hum.AutoRotate = true
		end
		syncFly(false)
	end

	local function startFly()
		local hum = getHum()
		if not hum or hum.Health <= 0 then
			syncFly(false)
			return
		end
		fly.On = true
		syncFly(true)
	end

	local function toggleFly()
		if fly.On then stopFly() else startFly() end
	end

