	-- ========= MODO FPS (otimização) =========
	local fps = { On = false, Ultra = false, token = 0, conns = {}, quality = nil, shadows = nil }
	fps.saved = setmetatable({}, { __mode = "k" }) -- [instância] = { propriedade = valor original }

	local function fpsSet(inst, prop, value)
		local t = fps.saved[inst]
		if not t then
			t = {}
			fps.saved[inst] = t
		end
		if t[prop] == nil then
			t[prop] = inst[prop] -- guarda o valor original uma vez só
		end
		inst[prop] = value
	end

	local function fpsApplyOne(inst)
		pcall(function()
			if inst:IsA("Terrain") then
				fpsSet(inst, "WaterWaveSize", 0)
				fpsSet(inst, "WaterWaveSpeed", 0)
				fpsSet(inst, "WaterReflectance", 0)
			elseif inst:IsA("BasePart") then
				fpsSet(inst, "Material", Enum.Material.SmoothPlastic)
				fpsSet(inst, "Reflectance", 0)
				fpsSet(inst, "CastShadow", false)
				if fps.Ultra and inst:IsA("MeshPart") then
					fpsSet(inst, "TextureID", "")
				end
			elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
				or inst:IsA("Fire") or inst:IsA("Smoke") or inst:IsA("Sparkles") then
				fpsSet(inst, "Enabled", false)
			elseif inst:IsA("BloomEffect") or inst:IsA("BlurEffect") or inst:IsA("SunRaysEffect")
				or inst:IsA("ColorCorrectionEffect") or inst:IsA("DepthOfFieldEffect") then
				fpsSet(inst, "Enabled", false)
			elseif inst:IsA("Atmosphere") then
				fpsSet(inst, "Density", 0)
			elseif fps.Ultra and (inst:IsA("Decal") or inst:IsA("Texture")) then
				fpsSet(inst, "Transparency", 1)
			elseif fps.Ultra and inst:IsA("SpecialMesh") then
				fpsSet(inst, "TextureId", "")
			end
		end)
	end

	local function fpsRestore()
		fps.token += 1 -- cancela qualquer aplicação em andamento
		for _, c in ipairs(fps.conns) do c:Disconnect() end
		fps.conns = {}

		for inst, props in pairs(fps.saved) do
			if inst and inst.Parent then
				for prop, val in pairs(props) do
					pcall(function() inst[prop] = val end)
				end
			end
		end
		table.clear(fps.saved)

		pcall(function()
			if fps.shadows ~= nil then Lighting.GlobalShadows = fps.shadows end
			if fps.quality ~= nil then settings().Rendering.QualityLevel = fps.quality end
		end)
		fps.shadows = nil
		fps.quality = nil
	end

	local function fpsApply()
		fps.token += 1
		local myToken = fps.token

		pcall(function()
			if fps.shadows == nil then fps.shadows = Lighting.GlobalShadows end
			if fps.quality == nil then fps.quality = settings().Rendering.QualityLevel end
			Lighting.GlobalShadows = false
			settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
		end)

		-- novos objetos que aparecerem também são otimizados
		for _, root in ipairs({ workspace, Lighting }) do
			table.insert(fps.conns, root.DescendantAdded:Connect(function(inst)
				if fps.On then fpsApplyOne(inst) end
			end))
		end

		-- aplica nos objetos existentes aos poucos, sem travar o jogo
		task.spawn(function()
			local n = 0
			for _, root in ipairs({ workspace, Lighting }) do
				for _, inst in ipairs(root:GetDescendants()) do
					if fps.token ~= myToken then return end
					fpsApplyOne(inst)
					n += 1
					if n % 300 == 0 then task.wait() end
				end
			end
		end)
	end

	local function setFpsMode(state)
		if state == fps.On then return end
		fps.On = state
		if state then fpsApply() else fpsRestore() end
	end

	local function setFpsUltra(state)
		fps.Ultra = state
		if fps.On then
			-- reaplica com a nova opção
			fpsRestore()
			fpsApply()
		end
	end

	-- ========= ATUALIZAÇÃO (todo quadro) =========
	RunService.RenderStepped:Connect(function(dt)
		local myChar = lp.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

		-- Voar
		if fly.On and myHrp and myHum then
			local seat = myHum.SeatPart

			if seat then
				detachFly()
				myHum.PlatformStand = false

				local root = seat.AssemblyRootPart or seat
				local dir = Vector3.zero
				if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
				if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero

				local cf = root.CFrame
				local yaw = 0
				if UIS:IsKeyDown(Enum.KeyCode.Q) then yaw += 1 end
				if UIS:IsKeyDown(Enum.KeyCode.E) then yaw -= 1 end
				if yaw ~= 0 then
					cf = CFrame.new(cf.Position) * CFrame.Angles(0, yaw * 2 * dt, 0) * cf.Rotation
				end

				root.CFrame = cf + dir * fly.Speed * dt
			else
				if myHrp ~= flyTarget or not bv or not bv.Parent then
					attachFly(myHrp)
				end
				myHum.PlatformStand = true
				myHum.AutoRotate = false

				local move = cam.CFrame:VectorToObjectSpace(myHum.MoveDirection)
				local dir = cam.CFrame.RightVector * move.X + cam.CFrame.LookVector * -move.Z
				if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
				if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir -= Vector3.yAxis end

				bv.Velocity = dir * fly.Speed

				local look = cam.CFrame.LookVector
				local flat = Vector3.new(look.X, 0, look.Z)
				if flat.Magnitude > 0.01 then
					bg.CFrame = CFrame.lookAt(myHrp.Position, myHrp.Position + flat)
				end
			end
		elseif not fly.On and flyTarget then
			detachFly()
		end

		-- ESP
		for player, o in pairs(objects) do
			if not (o.hrp and o.hrp.Parent) then
				clear(player)
			else
				o.box.Visible = settings.Caixa
				o.gui.Enabled = settings.Nome or settings.Vida

				o.name.Visible = settings.Nome
				o.hp.Visible = settings.Vida

				local hum = o.hum
				o.hp.Text = ("Vida: %d/%d"):format(math.floor(hum.Health), math.floor(hum.MaxHealth))
				local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
				o.hp.TextColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(80, 255, 80), pct)
			end
		end
	end)

