	local wallParams = RaycastParams.new()
	wallParams.FilterType = Enum.RaycastFilterType.Exclude

	-- devolve a parte mirada, o humanoid e o personagem se o jogador for um alvo válido
	local function getTargetParts(p)
		if not p or p == lp then return end
		if aim.Team and p.Team ~= nil and p.Team == lp.Team then return end
		local char = p.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not (hum and hrp) or hum.Health <= 0 then return end

		local part = hrp
		if aim.Part == "Head" then
			part = char:FindFirstChild("Head") or hrp
		elseif aim.Part == "Torso" then
			part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or hrp
		end

		if (part.Position - cam.CFrame.Position).Magnitude > aim.MaxDist then return end
		return part, hum, char
	end

	-- wall check: atravessa partes transparentes ou sem colisão (grama, vidro, etc.)
	local function hasWall(part, char)
		if not aim.Wall then return false end
		local origin = cam.CFrame.Position
		local filter = { char }
		if lp.Character then table.insert(filter, lp.Character) end
		for _ = 1, 4 do
			wallParams.FilterDescendantsInstances = filter
			local hit = workspace:Raycast(origin, part.Position - origin, wallParams)
			if not hit then return false end
			local inst = hit.Instance
			if inst.Transparency >= 0.9 or not inst.CanCollide then
				table.insert(filter, inst)
			else
				return true
			end
		end
		return true
	end

	-- ponto final da mira (com antecipação do movimento do alvo)
	local function aimPoint(part)
		if aim.Predict <= 0 then return part.Position end
		return part.Position + part.AssemblyLinearVelocity * (aim.Predict / 1000)
	end

	-- distância do centro do círculo (mouse) até o jogador na tela
	local function screenDist(part, mouse)
		local pos, onScreen = cam:WorldToViewportPoint(part.Position)
		if not onScreen then return nil end
		return (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
	end

	local function releaseAim(ignoreIt)
		aim.Ignore = ignoreIt and aim.Target or nil
		aim.Target = nil
		aim.Flick = 0
	end

	-- virar o mouse/dedo pro lado solta a trava
	UIS.InputChanged:Connect(function(input, gp)
		if gp or not aim.On or not aim.Target then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			aim.Flick += math.abs(input.Delta.X)
		end
	end)

	RunService:BindToRenderStep("AOI_Aim", Enum.RenderPriority.Camera.Value + 1, function(dt)
		-- desligada: não faz nada (barato)
		if not aim.On then
			if circle.Visible then circle.Visible = false end
			if dot.Visible then dot.Visible = false end
			if aimLabel.Visible then aimLabel.Visible = false end
			return
		end
		circle.Visible = true

		local mouse = UIS:GetMouseLocation()
		circle.Position = UDim2.fromOffset(mouse.X, mouse.Y)
		circle.Size = UDim2.fromOffset(aim.Radius * 2, aim.Radius * 2)
		aim.Flick = math.max(0, aim.Flick - 600 * dt) -- o movimento "esfria" com o tempo
		aimWallClock += dt
		aimSearchClock += dt

		-- modo "segurar botão direito": sem o botão, não trava
		if aim.HoldRMB and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			if aim.Target then releaseAim(false) end
			aimLabel.Visible = false
			dot.Visible = false
			circleStroke.Color = Color3.new(1, 1, 1)
			return
		end

		-- jogador solto só pode ser travado de novo depois de sair do círculo
		if aim.Ignore then
			local part = getTargetParts(aim.Ignore)
			local d = part and screenDist(part, mouse)
			if not d or d > aim.Radius then aim.Ignore = nil end
		end

		-- mantém ou solta o alvo atual (wall check só 10x por segundo)
		if aim.Target then
			local part, _, char = getTargetParts(aim.Target)
			if not part then
				releaseAim(false)
			else
				if aimWallClock >= AIM_WALL_INTERVAL then
					aimWallClock = 0
					if hasWall(part, char) then releaseAim(false) end
				end
				if aim.Target and aim.Flick > aim.FlickLimit then
					releaseAim(true)
				end
			end
		end

		-- procura um novo alvo dentro do círculo (20x por segundo, o mais perto do mouse)
		if not aim.Target and aimSearchClock >= AIM_SEARCH_INTERVAL then
			aimSearchClock = 0
			local best, bestDist
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= aim.Ignore then
					local part, _, char = getTargetParts(p)
					if part then
						local d = screenDist(part, mouse)
						if d and d <= aim.Radius and (not bestDist or d < bestDist) and not hasWall(part, char) then
							best, bestDist = p, d
						end
					end
				end
			end
			aim.Target = best
		end

		-- trava a câmera na parte escolhida
		local locked = false
		dot.Visible = false
		if aim.Target then
			local part = getTargetParts(aim.Target)
			if part then
				local point = aimPoint(part)
				local goal = CFrame.lookAt(cam.CFrame.Position, point)
				if aim.Smooth <= 0 then
					cam.CFrame = goal
				else
					local alpha = 1 - math.exp(-dt * 60 / aim.Smooth)
					cam.CFrame = cam.CFrame:Lerp(goal, alpha)
				end
				locked = true

				if aim.ShowDot then
					local pos, onScreen = cam:WorldToViewportPoint(point)
					if onScreen then
						dot.Position = UDim2.fromOffset(pos.X, pos.Y)
						dot.Visible = true
					end
				end
			end
		end
		local tcolor, ttext = Color3.new(1, 1, 1), nil
		if locked and aim.Target then
			local mate = aim.Target.Team ~= nil and aim.Target.Team == lp.Team
			tcolor = mate and COR_ALIADO or COR_INIMIGO
			ttext = (mate and "MEU TIME: " or "INIMIGO: ") .. aim.Target.DisplayName
		end
		circleStroke.Color = tcolor
		dot.BackgroundColor3 = tcolor
		if ttext then
			if aimLabel.Text ~= ttext then aimLabel.Text = ttext end
			aimLabel.TextColor3 = tcolor
			aimLabel.Position = UDim2.fromOffset(mouse.X, mouse.Y + aim.Radius + 14)
			aimLabel.Visible = true
		else
			aimLabel.Visible = false
		end
	end)

