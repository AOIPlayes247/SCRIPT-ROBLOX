				Desc = "Escolha a tecla. Padrão: " .. (DISPLAY_OF[KEY_DEFAULTS[action]] or KEY_DEFAULTS[action]) .. ".",
				Values = KEY_VALUES,
				Value = keyShown(action),
				Callback = function(value)
