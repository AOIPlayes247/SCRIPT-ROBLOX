	pcall(function() Window:CreateTopbarButton("BtnYoutube", "youtube", copyYoutube, 990) end)
	pcall(function() Window:CreateTopbarButton("BtnCreditos", "star", showCredits, 989) end)

	-- ========= BOLINHA COM A LOGO (reserva: botão padrão com gradiente) =========
	local hasLogo = LOGO_ID ~= ""
	local logoImage = hasLogo and ("rbxassetid://" .. LOGO_ID) or ""

	local bubbleGui = Instance.new("ScreenGui")
	bubbleGui.Name = "AOI_Bubble"
	bubbleGui.ResetOnSpawn = false
	bubbleGui.DisplayOrder = 999
	bubbleGui.Parent = (gethui and gethui()) or lp:WaitForChild("PlayerGui")

	local bubble = Instance.new("ImageButton")
	bubble.Size = UDim2.fromOffset(64, 64)
	bubble.Position = UDim2.new(0, 20, 0.5, 0)
	bubble.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
	bubble.Image = logoImage
	bubble.ScaleType = Enum.ScaleType.Crop
	bubble.AutoButtonColor = false
	bubble.Visible = false
	bubble.Parent = bubbleGui

	Instance.new("UICorner", bubble).CornerRadius = UDim.new(1, 0)

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Thickness = 2
	stroke.Parent = bubble

	-- Sem logo: mostra a letra "A" com gradiente vermelho e preto
	if not hasLogo then
		bubble.BackgroundColor3 = Color3.new(1, 1, 1)

		local grad = Instance.new("UIGradient")
		grad.Color = ColorSequence.new(Color3.fromHex("FF0000"), Color3.fromHex("1A0000"))
		grad.Rotation = 45
		grad.Parent = bubble

		local letter = Instance.new("TextLabel")
		letter.Size = UDim2.fromScale(1, 1)
		letter.BackgroundTransparency = 1
		letter.Text = "A"
		letter.Font = Enum.Font.GothamBlack
		letter.TextSize = 28
		letter.TextColor3 = Color3.new(1, 1, 1)
		letter.Parent = bubble
	end

	local isOpen = true

	local function openMenu()
		pcall(function() Window:Open() end)
		isOpen = true
		bubble.Visible = false
	end

	local okOpen = pcall(function()
		Window:OnOpen(function()
			isOpen = true
			bubble.Visible = false
		end)
	end)
	local okClose = pcall(function()
		Window:OnClose(function()
			isOpen = false
			bubble.Visible = true
		end)
	end)
	local bubbleAtiva = okOpen and okClose

	if bubbleAtiva then
		pcall(function() Window:EditOpenButton({ Enabled = false }) end)
	else
		bubble.Visible = false
		pcall(function()
			Window:EditOpenButton({
				Title = "Abrir Menu",
				Icon = hasLogo and logoImage or "monitor",
				CornerRadius = UDim.new(0, 16),
				StrokeThickness = 2,
				Color = ColorSequence.new(
					Color3.fromHex("FF0000"),
					Color3.fromHex("1A0000")
				),
				OnlyMobile = false,
				Enabled = true,
				Draggable = true,
			})
		end)
	end

	local dragging, dragStart, startPos, moved = false, nil, nil, false

	bubble.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = bubble.Position
		end
	end)

	UIS.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			if delta.Magnitude > 6 then moved = true end
			if moved then
				bubble.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end
	end)

	UIS.InputEnded:Connect(function(input)
		if not dragging then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if not moved and bubbleAtiva then
				openMenu()
			end
		end
	end)

	-- ========= ABA: ESP =========
	local espTab = Window:Tab({ Title = "ESP (Ver Jogadores)", Icon = "eye" })

	local espToggles = {
		{ "Caixa", "Caixa", "Desenha uma caixa em volta de cada jogador. Aparece através das paredes." },
		{ "Nome", "Nome do jogador", "Mostra o nome de cada jogador acima da cabeça." },
		{ "Vida", "Vida do jogador", "Mostra a vida atual e máxima. Vai de vermelho (pouca) a verde (cheia)." },
	}

	for _, item in ipairs(espToggles) do
