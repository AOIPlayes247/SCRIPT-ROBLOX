	local function stopNoclip()
		noclip.On = false
		for part, was in pairs(original) do
			if part and part.Parent then
				part.CanCollide = was
			end
		end
		table.clear(original)
		syncNoclip(false)
	end

	local function startNoclip()
		noclip.On = true
		syncNoclip(true)
	end

	local function toggleNoclip()
		if noclip.On then stopNoclip() else startNoclip() end
	end

	local function getVehicle(seat)
		local m = seat
		while m.Parent and m.Parent ~= workspace do
			m = m.Parent
		end
		return m
	end

	RunService.Stepped:Connect(function()
		if not noclip.On then return end
		local char = lp.Character
		if not char then return end

		local parts = {}
		for _, p in ipairs(char:GetDescendants()) do
			if p:IsA("BasePart") then table.insert(parts, p) end
		end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart
		if seat then
			for _, p in ipairs(seat:GetConnectedParts(true)) do
				table.insert(parts, p)
			end
			table.insert(parts, seat)
			for _, p in ipairs(getVehicle(seat):GetDescendants()) do
				if p:IsA("BasePart") then table.insert(parts, p) end
			end
		end

		for _, part in ipairs(parts) do
			if original[part] == nil then
				original[part] = part.CanCollide
			end
			part.CanCollide = false
		end
	end)

	lp.CharacterAdded:Connect(function()
		table.clear(original)
		noclip.On = false
		syncNoclip(false)
	end)

	-- ========= TELEPORTE PARA JOGADOR =========
	local tp = { Selected = nil, Typed = "" }
	local tpDropdown

	local function playerNames()
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp then table.insert(list, p.Name) end
		end
		table.sort(list)
		return list
	end

	local function findPlayer(text)
		if not text or text == "" then return nil end
		text = text:lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and (p.Name:lower() == text or p.DisplayName:lower() == text) then
				return p
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and (p.Name:lower():find(text, 1, true) or p.DisplayName:lower():find(text, 1, true)) then
				return p
			end
		end
		return nil
	end

	local function teleportTo(name)
		local target = findPlayer(name)
		if not target then
			WindUI:Notify({ Title = "Teleporte", Content = "Jogador não encontrado.", Duration = 5 })
			return
		end
		local tChar = target.Character
		local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
		local myChar = lp.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not (tHrp and myHrp) then
			WindUI:Notify({ Title = "Teleporte", Content = "Esse jogador está sem personagem agora.", Duration = 5 })
			return
		end

		local dest = tHrp.CFrame * CFrame.new(0, 3, 5)
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart
		if seat then
			local root = seat.AssemblyRootPart or seat
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = dest
		else
			myHrp.AssemblyLinearVelocity = Vector3.zero
			myChar:PivotTo(dest)
		end
		WindUI:Notify({ Title = "Teleporte", Content = "Você foi até " .. target.DisplayName .. ".", Duration = 4 })
	end

