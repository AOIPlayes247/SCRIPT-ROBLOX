		local copied = false
		if setclipboard then
			copied = pcall(setclipboard, YOUTUBE)
		end
		WindUI:Notify({
			Title = "Créditos - " .. CREATOR,
			Content = copied and "Link do YouTube copiado! Cole no navegador." or ("Canal: " .. YOUTUBE),
