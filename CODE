	})

	-- ========= TECLAS =========
	UIS.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.V then
			toggleFly()
		elseif input.KeyCode == Enum.KeyCode.G then
			toggleNoclip()
		elseif input.KeyCode == Enum.KeyCode.R then
			toggleRegen()
