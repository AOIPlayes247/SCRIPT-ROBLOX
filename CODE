	local function syncRegen(state)
		if regenToggle then
			syncing = true
			pcall(function() regenToggle:Set(state) end)
			syncing = false
		end
	end

	local function fireRegen()
		local remote = RS:FindFirstChild("AdminRegenEvent")
		if remote then remote:FireServer(regen.On, regen.Rate) end
	end

	local function startRegen()
		regen.On = true
		fireRegen()
		syncRegen(true)
	end

	local function stopRegen(fromUI)
		regen.On = false
		fireRegen()
		if not fromUI then syncRegen(false) end
