		Callback = refreshDropdown,
	})

	-- ========= ABA: REGENERAÇÃO DE VIDA =========
	local vidaTab = Window:Tab({ Title = "Regenerar Vida", Icon = "heart" })

	regenToggle = vidaTab:Toggle({
		Title = "Regenerar vida (tecla R)",
		Desc = "Sua vida sobe sozinha até o máximo. Continua ligada ao renascer e só desliga pelo toggle ou pela tecla R. Precisa da parte de servidor no seu jogo.",
		Default = false,
		Callback = function(state)
