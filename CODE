	RunService.Heartbeat:Connect(function(dt)
		if not esp.On then return end
		espClock += dt
		if espClock < ESP_INTERVAL then return end
		espClock = 0

		local now = os.clock()
		local camPos = cam.CFrame.Position
		local raysLeft = VIS_MAX_PER_TICK

		for player, o in pairs(objects) do
			if not (o.hrp and o.hrp.Parent and o.char and o.char.Parent) then
				clear(player)
			else
				local hum = o.hum
				local dist = (o.hrp.Position - camPos).Magnitude
				local hide = dist > settings.Dist
					or hum.Health <= 0
					or (settings.Team and player.Team ~= nil and player.Team == lp.Team)

				o.box.Visible = settings.Caixa and not hide
				o.gui.Enabled = (settings.Nome or settings.Vida or settings.Distancia) and not hide

				if not hide then
					if settings.Caixa then
						-- tamanho da caixa: só de vez em quando
						if now - o.lastBox > BOX_INTERVAL then
							o.lastBox = now
							local cf, size = o.char:GetBoundingBox()
							o.box.Size = size
							o.box.CFrame = o.hrp.CFrame:ToObjectSpace(cf)
						end

						-- cor = time (rosa inimigo, verde meu time); caixa forte = você vê, fraca = atrás de parede
						o.box.Color3 = isMate(player) and COR_ALIADO or COR_INIMIGO
						if settings.Visib then
							if raysLeft > 0 and now - o.lastVis > VIS_INTERVAL then
								o.lastVis = now
								raysLeft -= 1
								o.visible = canSee(o.hrp, o.char)
							end
							o.box.Transparency = o.visible and 0.35 or 0.8
						else
							o.box.Transparency = 0.6
						end
					end

					o.name.Visible = settings.Nome
					o.name.TextColor3 = isMate(player) and COR_ALIADO or COR_INIMIGO
					o.hp.Visible = settings.Vida
					o.dist.Visible = settings.Distancia

					if settings.Distancia then
						setText(o.dist, ("Distância: %d studs"):format(math.floor(dist + 0.5)))
					end
					if settings.Vida then
						-- arredonda para cima: quem está vivo nunca aparece com 0
						setText(o.hp, ("Vida: %d/%d"):format(math.ceil(hum.Health), math.ceil(hum.MaxHealth)))
						local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
						o.hp.TextColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(80, 255, 80), pct)
					end
				end
			end
		end
	end)

