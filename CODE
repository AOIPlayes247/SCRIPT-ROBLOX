	-- ========= ATRAVESSAR PAREDE (noclip) =========
	local noclip = { On = false }
	local original = {}

	-- lista em cache (não varre o personagem/carro todo quadro)
	local noclipParts = {}
	local noclipSeat, noclipClock = nil, 0

	local function syncNoclip(state)
		if noclipToggle then
			syncing = true
			pcall(function() noclipToggle:Set(state) end)
			syncing = false
		end
	end

	local function stopNoclip()
		noclip.On = false
		for part, was in pairs(original) do
			if part and part.Parent then
				part.CanCollide = was
			end
		end
		table.clear(original)
		table.clear(noclipParts)
		noclipSeat = nil -- força reconstruir a lista na próxima vez que ligar
		syncNoclip(false)
	end

	local function startNoclip()
		noclip.On = true
		noclipSeat = nil
		noclipClock = 999 -- reconstrói a lista no primeiro quadro
		syncNoclip(true)
	end

	local function toggleNoclip()
		if noclip.On then stopNoclip() else startNoclip() end
	end

	local function getVehicle(seat)
		local m = seat
		while m.Parent and m.Parent ~= workspace do
			m = m.Parent
		end
		return m
	end

	local function rebuildNoclipParts(seat)
		table.clear(noclipParts)
		local char = lp.Character
		if char then
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") then noclipParts[#noclipParts + 1] = p end
			end
		end
		if seat then
			noclipParts[#noclipParts + 1] = seat
			for _, p in ipairs(seat:GetConnectedParts(true)) do
				noclipParts[#noclipParts + 1] = p
			end
			-- só usa o modelo inteiro se ele for pequeno (evita varrer o mapa)
			local model = getVehicle(seat)
			if model ~= workspace and #model:GetChildren() < 200 then
				for _, p in ipairs(model:GetDescendants()) do
					if p:IsA("BasePart") then noclipParts[#noclipParts + 1] = p end
				end
			end
		end
	end

	RunService.Stepped:Connect(function(_, dt)
		if not noclip.On then return end
		local char = lp.Character
		if not char then return end

		local hum = char:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart

		-- só reconstrói a lista se mudou de assento ou a cada 1 segundo
		noclipClock += dt
		if seat ~= noclipSeat or noclipClock > 1 then
			noclipSeat, noclipClock = seat, 0
			rebuildNoclipParts(seat)
		end

		for i = 1, #noclipParts do
			local part = noclipParts[i]
			if part.CanCollide then
				if original[part] == nil then original[part] = true end
				part.CanCollide = false
			end
		end
	end)

	lp.CharacterAdded:Connect(function()
		table.clear(original)
		table.clear(noclipParts)
		noclipSeat = nil
		noclip.On = false
		syncNoclip(false)
	end)

	-- ========= TELEPORTE PARA JOGADOR =========
	local tp = { Selected = nil, Typed = "" }
	local tpDropdown

	local function playerNames()
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp then table.insert(list, p.Name) end
		end
		table.sort(list)
		return list
	end

	local function findPlayer(text)
		if not text or text == "" then return nil end
		text = text:lower()
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and (p.Name:lower() == text or p.DisplayName:lower() == text) then
				return p
			end
		end
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and (p.Name:lower():find(text, 1, true) or p.DisplayName:lower():find(text, 1, true)) then
				return p
			end
		end
		return nil
	end

	local function teleportTo(name)
		local target = findPlayer(name)
		if not target then
			WindUI:Notify({ Title = "Teleporte", Content = "Jogador não encontrado.", Duration = 5 })
			return
		end
		local tChar = target.Character
		local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
		local myChar = lp.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if not (tHrp and myHrp) then
			WindUI:Notify({ Title = "Teleporte", Content = "Esse jogador está sem personagem agora.", Duration = 5 })
			return
		end

		local dest = tHrp.CFrame * CFrame.new(0, 3, 5)
		local hum = myChar:FindFirstChildOfClass("Humanoid")
		local seat = hum and hum.SeatPart
		if seat then
			local root = seat.AssemblyRootPart or seat
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = dest
		else
			myHrp.AssemblyLinearVelocity = Vector3.zero
			myChar:PivotTo(dest)
		end
		WindUI:Notify({ Title = "Teleporte", Content = "Você foi até " .. target.DisplayName .. ".", Duration = 4 })
	end

