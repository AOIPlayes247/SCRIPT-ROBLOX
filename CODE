	local keyDropdowns = {}

	local function setKey(action, shown, dd)
		local real = ENUM_OF[shown] or shown
		if real == keybinds[action] then return end

		-- não deixa duas funções na mesma tecla
		for other, key in pairs(keybinds) do
			if other ~= action and key == real then
				WindUI:Notify({
					Title = "Atalho em uso",
					Content = "A tecla " .. shown .. " já é de \"" .. KEY_LABELS[other] .. "\". Mantive a tecla " .. keyShown(action) .. " para \"" .. KEY_LABELS[action] .. "\".",
					Duration = 6,
				})
				if dd then
					pcall(function() dd:Select(keyShown(action)) end)
				end
				return
			end
		end

		keybinds[action] = real
		refreshShortcuts()
		WindUI:Notify({
			Title = "Atalho alterado",
			Content = KEY_LABELS[action] .. " agora usa a tecla " .. shown .. ".",
			Duration = 4,
		})
	end

