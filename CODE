		if regen.On then stopRegen() else startRegen() end
	end

	-- ========= VELOCIDADE (correr rápido) =========
	local speed = { On = false, Value = 50, orig = 16, conn = nil, hb = nil }

	local function syncSpeed(state)
		if speedToggle then
			syncing = true
			pcall(function() speedToggle:Set(state) end)
			syncing = false
		end
	end

	local function getHum()
		local char = lp.Character
		return char and char:FindFirstChildOfClass("Humanoid")
	end

	local function releaseSpeed()
		if speed.conn then speed.conn:Disconnect() speed.conn = nil end
		if speed.hb then speed.hb:Disconnect() speed.hb = nil end
	end

	local function applySpeed()
		releaseSpeed()
		local hum = getHum()
		if not hum then return end
		hum.WalkSpeed = speed.Value

		speed.conn = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if speed.On and hum.WalkSpeed ~= speed.Value then
				hum.WalkSpeed = speed.Value
			end
		end)
		speed.hb = RunService.Heartbeat:Connect(function()
			if speed.On and hum.WalkSpeed ~= speed.Value then
				hum.WalkSpeed = speed.Value
			end
		end)
	end

	local function startSpeed()
		local hum = getHum()
		if not speed.On and hum then
			speed.orig = hum.WalkSpeed
			if speed.orig >= speed.Value then speed.orig = 16 end
		end
		speed.On = true
		applySpeed()
		syncSpeed(true)
	end

	local function stopSpeed(fromUI)
		speed.On = false
		releaseSpeed() -- solta tudo ANTES de restaurar (evita o atraso)
		local hum = getHum()
		if hum then
			hum.WalkSpeed = speed.orig
			task.defer(function()
				if not speed.On and hum and hum.Parent then
					hum.WalkSpeed = speed.orig
				end
			end)
		end
		if not fromUI then syncSpeed(false) end
	end

	local function toggleSpeed()
		if speed.On then stopSpeed() else startSpeed() end
	end

	lp.CharacterAdded:Connect(function(char)
		if speed.On then
			local hum = char:WaitForChild("Humanoid", 5)
			if hum then
				speed.orig = hum.WalkSpeed
				applySpeed()
			end
		end
	end)

