local RunService = game:GetService("RunService")

-- ========================================================
--  CONFIGURAÇÃO: coloque seu UserId (e de outros admins)
-- ========================================================
local ADMINS = {
	[1234567890] = true, -- troque pelo seu UserId
}

local REGEN_MIN, REGEN_MAX = 1, 100

if RunService:IsServer() then
	-- ====================================================
	--  PARTE DO SERVIDOR (regeneração de vida de verdade)
	-- ====================================================
	local Players = game:GetService("Players")
	local RS = game:GetService("ReplicatedStorage")

	local remote = Instance.new("RemoteEvent")
	remote.Name = "AdminRegenEvent"
	remote.Parent = RS

	local state = {} -- [player] = { on, rate, conn }

	local function setup(player)
		if not ADMINS[player.UserId] then return end
		local s = { on = false, rate = 10, conn = nil }
		state[player] = s

		s.conn = RunService.Heartbeat:Connect(function(dt)
			if not s.on then return end
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and hum.Health < hum.MaxHealth then
				hum.Health = math.min(hum.MaxHealth, hum.Health + s.rate * dt)
			end
		end)
	end

	remote.OnServerEvent:Connect(function(player, on, rate)
		if not ADMINS[player.UserId] then return end
		local s = state[player]
		if not s then return end
		s.on = (on == true)
		if typeof(rate) == "number" then
			s.rate = math.clamp(rate, REGEN_MIN, REGEN_MAX)
		end
	end)

	Players.PlayerAdded:Connect(setup)
	Players.PlayerRemoving:Connect(function(player)
		local s = state[player]
		if s and s.conn then s.conn:Disconnect() end
		state[player] = nil
	end)
	for _, p in ipairs(Players:GetPlayers()) do
		setup(p)
	end

else
