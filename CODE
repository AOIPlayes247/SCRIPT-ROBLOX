	-- ========= ESP: CRIAR / REMOVER =========
	local buildToken = {} -- evita ESP duplicado se o jogador renascer rápido

	-- cores compartilhadas pelo ESP e pela Mira: rosa = inimigo, verde = meu time
	local COR_INIMIGO = Color3.fromRGB(255, 70, 190)
	local COR_ALIADO = Color3.fromRGB(80, 255, 80)

	local function isMate(p)
		return p.Team ~= nil and p.Team == lp.Team
	end

	local visParams = RaycastParams.new()
	visParams.FilterType = Enum.RaycastFilterType.Exclude

	-- true se há linha de visão da câmera até a parte (ignora vidro e partes sem colisão)
	local function canSee(part, char)
		local origin = cam.CFrame.Position
		local filter = { char }
		if lp.Character then table.insert(filter, lp.Character) end
		for _ = 1, 4 do
			visParams.FilterDescendantsInstances = filter
			local hit = workspace:Raycast(origin, part.Position - origin, visParams)
			if not hit then return true end
			local inst = hit.Instance
			if inst.Transparency >= 0.9 or not inst.CanCollide then
				table.insert(filter, inst)
			else
				return false
			end
		end
		return false
	end

	local function clear(player)
		local o = objects[player]
		if o then
			if o.diedConn then o.diedConn:Disconnect() end
			o.folder:Destroy()
			objects[player] = nil
		end
	end

	local function makeLabel(parent, order, color)
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.new(1, 0, 0, 14)
		l.Font = Enum.Font.GothamBold
		l.TextSize = 13
		l.TextColor3 = color
		l.TextStrokeTransparency = 0
		l.LayoutOrder = order
		l.Parent = parent
		return l
	end

	local function build(player, char)
		clear(player)
		if player == lp then return end
		if not esp.On then return end

		buildToken[player] = (buildToken[player] or 0) + 1
		local myToken = buildToken[player]

		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		local hum = char:WaitForChild("Humanoid", 5)
		local head = char:WaitForChild("Head", 5)
		if not (hrp and hum and head) then return end
		if hum.Health <= 0 then return end

		-- o jogador renasceu ou saiu enquanto esperava: cancela
		if buildToken[player] ~= myToken or not char.Parent or not esp.On then return end

		local folder = Instance.new("Folder")
		folder.Name = player.Name
		folder.Parent = container

		-- caixa: o tamanho é ajustado ao corpo real de tempos em tempos
		local box = Instance.new("BoxHandleAdornment")
		box.Adornee = hrp
		box.Size = Vector3.new(4, 5.5, 1.5)
		box.AlwaysOnTop = true
		box.ZIndex = 5
		box.Transparency = 0.6
		box.Color3 = COR_INIMIGO
		box.Parent = folder

		local gui = Instance.new("BillboardGui")
		gui.Adornee = head
		gui.AlwaysOnTop = true
		gui.MaxDistance = math.huge
		gui.Size = UDim2.new(0, 160, 0, 46)
		gui.StudsOffset = Vector3.new(0, 3.5, 0)
		gui.Parent = folder

		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		layout.Parent = gui

		local nameL = makeLabel(gui, 1, Color3.new(1, 1, 1))
		local hpL = makeLabel(gui, 2, Color3.fromRGB(80, 255, 80))
		local distL = makeLabel(gui, 3, Color3.fromRGB(255, 220, 90))
		nameL.Text = player.DisplayName

		local o = {
			folder = folder, box = box, gui = gui, char = char,
			name = nameL, hp = hpL, dist = distL, hrp = hrp, hum = hum,
			lastVis = 0, lastBox = 0, visible = true,
		}
		objects[player] = o

		-- Morreu: deleta (recria no CharacterAdded ao renascer)
		o.diedConn = hum.Died:Connect(function()
			clear(player)
		end)
	end

	local function track(player)
		if player == lp then return end
		player.CharacterAdded:Connect(function(char)
			build(player, char)
		end)
		player.CharacterRemoving:Connect(function()
			buildToken[player] = (buildToken[player] or 0) + 1
			clear(player)
		end)
		if player.Character then
			task.spawn(build, player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(track)      -- entrou: cria o ESP dele
	Players.PlayerRemoving:Connect(function(player)
		buildToken[player] = (buildToken[player] or 0) + 1
		clear(player)
		buildToken[player] = nil
	end)
	for _, p in ipairs(Players:GetPlayers()) do track(p) end

	local function syncEsp(state)
		if espToggle then
			syncing = true
			pcall(function() espToggle:Set(state) end)
			syncing = false
		end
	end

	local function startEsp()
		esp.On = true
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= lp and p.Character then
				task.spawn(build, p, p.Character)
			end
		end
		syncEsp(true)
	end

	local function stopEsp(fromUI)
		esp.On = false
		for p in pairs(buildToken) do buildToken[p] += 1 end -- cancela ESPs em construção
		for p in pairs(objects) do clear(p) end              -- apaga tudo da tela
		if not fromUI then syncEsp(false) end
	end

	local function toggleEsp()
		if esp.On then stopEsp() else startEsp() end
	end

